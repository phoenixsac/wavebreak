# Copy to .env (make up does this automatically). No real secrets in this file.
PROFILE=lite

# hawkBit (UI, DDI, Management API)
HAWKBIT_URL=http://localhost:8080
HAWKBIT_TENANT=DEFAULT
HAWKBIT_USERNAME=admin
HAWKBIT_PASSWORD=admin
HAWKBIT_LAB_USERNAME=lab
HAWKBIT_LAB_PASSWORD=lab
HAWKBIT_HEAP=512m
# DDI auth: gateway (one token for all devices) or target (per-device tokens)
HAWKBIT_DDI_AUTH=gateway
HAWKBIT_GATEWAY_TOKEN=change-me-gateway-token
HAWKBIT_POLLING_TIME=00:00:10
# hawkBit MCP (streamable HTTP, path /mcp; clients send hawkBit basic auth)
HAWKBIT_MCP_URL=http://localhost:8082/mcp

# Observability
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=admin
# Written by scripts/grafana-sa.sh (read-only service account for mcp-grafana)
GRAFANA_SA_TOKEN=
MCP_GRAFANA_URL=http://localhost:8000/mcp

# Rehearsal lab
LAB_CONTROLLER_URL=http://localhost:8090
LAB_API_TOKEN=change-me-lab-token
LAB_DEVICE_TOKEN=change-me-lab-device-token

# AWS (infra/aws)
AWS_REGION=us-east-1
AWS_INSTANCE_TYPE=m8i.2xlarge
