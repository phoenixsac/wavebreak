{
  "annotations": {"list": []},
  "description": "Device release mix, app memory, restart counts, frame rate, and runtime failure logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "wb-prometheus"},
      "description": "Current device series grouped by firmware version.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "mappings": [], "unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "wb-prometheus"}, "expr": "count by (fw_version) (wavebreak_app_info)", "legendFormat": "{{fw_version}}", "refId": "A"}],
      "title": "Devices by firmware",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "wb-prometheus"},
      "description": "App cgroup memory.current, which reflects the device MemoryMax limit.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never"}, "mappings": [], "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "wb-prometheus"}, "expr": "wavebreak_app_cgroup_memory_bytes", "legendFormat": "{{device_id}} {{hw_rev}} {{fw_version}}", "refId": "A"}],
      "title": "App cgroup memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "wb-prometheus"},
      "description": "systemd NRestarts for inference-app, split by device and firmware series.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "mappings": [], "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "wb-prometheus"}, "expr": "wavebreak_app_restarts_total", "legendFormat": "{{device_id}} {{hw_rev}} {{fw_version}}", "refId": "A"}],
      "title": "App restarts",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "wb-prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineWidth": 1, "showPoints": "never"}, "mappings": [], "unit": "fps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "wb-prometheus"}, "expr": "wavebreak_app_fps", "legendFormat": "{{device_id}} {{hw_rev}} {{fw_version}}", "refId": "A"}],
      "title": "Frames per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "wb-loki"},
      "description": "Runtime OOM and killed-process messages from device journald.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 5,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"datasource": {"type": "loki", "uid": "wb-loki"}, "expr": "{job=\"wavebreak\",source=\"journal\"} |~ \"(?i)oom|killed process\"", "refId": "A"}],
      "title": "OOM and killed-process logs",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["wavebreak", "fleet"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Wavebreak Fleet",
  "uid": "wavebreak-fleet",
  "version": 1
}
